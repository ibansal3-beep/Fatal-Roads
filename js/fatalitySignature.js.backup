/**
 * Fatality Signature Explorer
 * CSE 478 — Fatal Roads
 *
 * Radial weekday × hour fingerprint of fatal crashes.
 * Requires D3 v7 loaded globally.
 */

const DAYS = [
  "Monday", "Tuesday", "Wednesday", "Thursday",
  "Friday", "Saturday", "Sunday"
];

const TWO_PI = Math.PI * 2;

function normalizeDay(row) {
  const name = String(row.weekday_name ?? "").trim().toLowerCase();
  const index = DAYS.findIndex(day => day.toLowerCase() === name);

  if (index !== -1) return index;

  // FARS: Sunday=1, Monday=2, ..., Saturday=7.
  const code = Number(row.weekday);
  if (Number.isInteger(code) && code >= 1 && code <= 7) {
    return (code + 5) % 7;
  }

  return -1;
}

function mostCommon(rows, field) {
  const counts = d3.rollup(
    rows.filter(row => String(row[field] ?? "").trim()),
    values => values.length,
    row => String(row[field]).trim()
  );

  if (!counts.size) return "Not recorded";

  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1])[0][0];
}

function buildCells(rows) {
  const valid = rows
    .map(row => ({
      ...row,
      dayIndex: normalizeDay(row),
      hourIndex: Number(row.hour),
      fatalitiesValue: Number(row.fatalities)
    }))
    .filter(row =>
      row.dayIndex >= 0 &&
      Number.isInteger(row.hourIndex) &&
      row.hourIndex >= 0 &&
      row.hourIndex <= 23
    );

  const grouped = d3.group(
    valid,
    row => row.dayIndex,
    row => row.hourIndex
  );

  return d3.range(7).flatMap(dayIndex =>
    d3.range(24).map(hourIndex => {
      const observations = grouped.get(dayIndex)?.get(hourIndex) ?? [];
      const crashes = observations.length;
      const fatalities = d3.sum(
        observations,
        row => Number.isFinite(row.fatalitiesValue)
          ? row.fatalitiesValue
          : 0
      );

      return {
        dayIndex,
        hourIndex,
        crashes,
        fatalities,
        averageFatalities: crashes ? fatalities / crashes : 0,
        weather: mostCommon(observations, "weather"),
        lighting: mostCommon(observations, "lighting")
      };
    })
  );
}

/**
 * @param {Object} config
 * @param {Array} config.data - geographic_points.csv rows
 * @param {string} [config.container="#fatality-signature"]
 * @param {string|number|null} [config.stateCode=null]
 * @returns {Object} chart API with updateState and destroy
 */
export function renderFatalitySignature({
  data,
  container = "#fatality-signature",
  stateCode = null
}) {
  const root = d3.select(container);

  if (root.empty()) {
    console.warn(`Fatality Signature container not found: ${container}`);
    return {
      updateState() {},
      destroy() {}
    };
  }

  if (!Array.isArray(data)) {
    throw new Error("Fatality Signature requires geographic crash rows.");
  }

  root.selectAll("*").remove();

  const wrapper = root.append("div")
    .attr("class", "signature-visualization");

  const summary = wrapper.append("div")
    .attr("class", "signature-summary")
    .style("margin-bottom", "12px");

  const svg = wrapper.append("svg")
    .attr("viewBox", "0 0 720 720")
    .attr("role", "img")
    .attr(
      "aria-label",
      "Radial chart of fatal crashes by weekday and hour"
    )
    .style("width", "100%")
    .style("max-width", "720px")
    .style("height", "auto")
    .style("display", "block")
    .style("margin", "0 auto");

  const center = svg.append("g")
    .attr("transform", "translate(360,360)");

  const tooltip = wrapper.append("div")
    .attr("class", "signature-tooltip")
    .style("position", "absolute")
    .style("pointer-events", "none")
    .style("display", "none")
    .style("background", "#111827")
    .style("color", "#fff")
    .style("padding", "12px 14px")
    .style("border", "1px solid #475569")
    .style("border-radius", "8px")
    .style("font-size", "13px")
    .style("line-height", "1.6")
    .style("z-index", "10");

  wrapper.style("position", "relative");

  const innerRadius = 92;
  const outerRadius = 288;
  const ringWidth = (outerRadius - innerRadius) / 7;

  const arc = d3.arc()
    .innerRadius(d => innerRadius + d.dayIndex * ringWidth + 1)
    .outerRadius(d => innerRadius + (d.dayIndex + 1) * ringWidth - 1)
    .startAngle(d => d.hourIndex * TWO_PI / 24)
    .endAngle(d => (d.hourIndex + 1) * TWO_PI / 24)
    .padAngle(0.004);

  const color = d3.scaleSequential(d3.interpolateYlOrRd);

  center.selectAll(".signature-hour-label")
    .data(d3.range(24))
    .join("text")
    .attr("class", "signature-hour-label")
    .attr("x", hour => {
      const angle = (hour + 0.5) * TWO_PI / 24 - Math.PI / 2;
      return Math.cos(angle) * 311;
    })
    .attr("y", hour => {
      const angle = (hour + 0.5) * TWO_PI / 24 - Math.PI / 2;
      return Math.sin(angle) * 311;
    })
    .attr("text-anchor", "middle")
    .attr("dominant-baseline", "middle")
    .attr("fill", "#cbd5e1")
    .attr("font-size", "12")
    .text(hour => String(hour).padStart(2, "0"));

  center.selectAll(".signature-day-label")
    .data(DAYS)
    .join("text")
    .attr("class", "signature-day-label")
    .attr("x", 0)
    .attr("y", (_, index) =>
      -(innerRadius + (index + 0.5) * ringWidth)
    )
    .attr("text-anchor", "middle")
    .attr("dominant-baseline", "middle")
    .attr("font-size", "10")
    .attr("font-weight", "600")
    .attr("fill", "#f8fafc")
    .text(day => day.slice(0, 3));

  const centerLabel = center.append("text")
    .attr("text-anchor", "middle")
    .attr("y", -12)
    .attr("font-size", "17")
    .attr("font-weight", "700")
    .attr("fill", "#f8fafc");

  const centerValue = center.append("text")
    .attr("text-anchor", "middle")
    .attr("y", 15)
    .attr("font-size", "24")
    .attr("font-weight", "700")
    .attr("fill", "#fb7185");

  const centerCaption = center.append("text")
    .attr("text-anchor", "middle")
    .attr("y", 34)
    .attr("font-size", "10")
    .attr("fill", "#cbd5e1")
    .text("fatal crashes");

  const legend = wrapper.append("div")
    .style("display", "flex")
    .style("align-items", "center")
    .style("justify-content", "center")
    .style("gap", "12px")
    .style("flex-wrap", "wrap")
    .style("margin-top", "10px");

  legend.append("span")
    .style("font-size", "12px")
    .text("Fewer crashes");

  const legendGradient = legend.append("div")
    .style("width", "180px")
    .style("height", "12px")
    .style("border-radius", "4px")
    .style(
      "background",
      "linear-gradient(to right, #ffffcc, #fd8d3c, #800026)"
    );

  legend.append("span")
    .style("font-size", "12px")
    .text("More crashes");

  const format = d3.format(",");

  let selectedStateCode = stateCode;

  function updateState(nextStateCode = null) {
    selectedStateCode =
      nextStateCode === "" || nextStateCode == null
        ? null
        : Number(nextStateCode);

    const filtered = selectedStateCode == null
      ? data
      : data.filter(row =>
          Number(row.state_code) === selectedStateCode
        );

    const cells = buildCells(filtered);
    const maximum = d3.max(cells, cell => cell.crashes) || 1;

    color.domain([0, maximum]);

    const crashTotal = filtered.length;
    const fatalityTotal = d3.sum(filtered, row =>
      Number(row.fatalities) || 0
    );

    const stateName = selectedStateCode == null
      ? "United States"
      : filtered[0]?.state ?? `State ${selectedStateCode}`;

    centerLabel.text(
      stateName.length > 17
        ? `${stateName.slice(0, 15)}…`
        : stateName
    );

    centerValue.text(format(crashTotal));

    summary.text(
      `${stateName}: ${format(crashTotal)} fatal crashes and ` +
      `${format(fatalityTotal)} fatalities. ` +
      `Each segment represents one weekday and one hour of the day.`
    );

    center.selectAll(".signature-cell")
      .data(cells, cell => `${cell.dayIndex}-${cell.hourIndex}`)
      .join(
        enter => enter.append("path")
          .attr("class", "signature-cell")
          .attr("d", arc)
          .attr("stroke", "#0f172a")
          .attr("stroke-width", 0.6),
        update => update,
        exit => exit.remove()
      )
      .attr("fill", cell =>
        cell.crashes === 0 ? "#273244" : color(cell.crashes)
      )
      .style("cursor", "pointer")
      .on("mouseenter", function (event, cell) {
        d3.select(this)
          .attr("stroke", "#ffffff")
          .attr("stroke-width", 2);

        tooltip.style("display", "block");

        tooltip.text(
          `${DAYS[cell.dayIndex]}, ` +
          `${String(cell.hourIndex).padStart(2, "0")}:00–` +
          `${String((cell.hourIndex + 1) % 24).padStart(2, "0")}:00 | ` +
          `${format(cell.crashes)} fatal crashes | ` +
          `${format(cell.fatalities)} fatalities | ` +
          `${cell.averageFatalities.toFixed(2)} fatalities/crash | ` +
          `Most common weather: ${cell.weather} | ` +
          `Most common lighting: ${cell.lighting}`
        );
      })
      .on("mousemove", function (event) {
        const bounds = wrapper.node().getBoundingClientRect();

        const x = Math.min(
          event.clientX - bounds.left + 14,
          bounds.width - 280
        );

        const y = event.clientY - bounds.top + 14;

        tooltip
          .style("left", `${Math.max(0, x)}px`)
          .style("top", `${Math.max(0, y)}px`);
      })
      .on("mouseleave", function () {
        d3.select(this)
          .attr("stroke", "#0f172a")
          .attr("stroke-width", 0.6);

        tooltip.style("display", "none");
      });

    if (!filtered.length) {
      summary.text(
        `No geographic crash records found for ${stateName}.`
      );
    }
  }

  updateState(selectedStateCode);

  return {
    updateState,
    destroy() {
      root.selectAll("*").remove();
    }
  };
}
